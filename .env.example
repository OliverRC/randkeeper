# Copy to .env and fill in. Never commit .env.

# --- App ---------------------------------------------------------------------
# Session cookie encryption key. Any random string, 32+ chars.
# Generate: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-with-a-random-string-at-least-32-chars

# The only email address allowed to log in.
NUXT_OWNER_EMAIL=you@example.com

# --- Bank --------------------------------------------------------------------
# mock      = generated sample data (no credentials needed)
# investec  = live Investec Programmable Banking (SA Private Bank)
NUXT_BANK_PROVIDER=mock

# Investec Programmable Banking credentials.
# Get them from Investec Online → Programmable Banking → API keys (or ask your banker to enable it).
# Docs: https://developer.investec.com/api-reference/SA%20PB%20Account%20Information
NUXT_INVESTEC_CLIENT_ID=
NUXT_INVESTEC_CLIENT_SECRET=
NUXT_INVESTEC_API_KEY=
